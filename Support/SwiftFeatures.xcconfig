// 本仓所有 Swift 语言/并发/内存安全开关的唯一落点。
//
// 为什么集中在这里：两个 target（Amber / AmberTests）× Debug/Release 共四份
// buildSettings，直接写进 project.pbxproj 意味着每加一个开关要手抄四处，改错一处
// 不报错、只是那一份配置悄悄少一个开关。放进 xcconfig 之后工程级引一次、target 继承，
// 每次改动就是这一个文本文件，diff 一眼看完，回退就是注释掉一行。
//
// 签名那份串在这里，所以工程级只引本文件一份。
#include "Signing.xcconfig"

// MARK: - 语言模式
//
// 语言模式只有 4 / 4.2 / 5 / 6 —— 编译器原话：
//   note: valid arguments to '-language-mode' are '4', '4.2', '5', '6'
// 「6.0」的 .0 是 Xcode 的显示格式，不是小版本。编译器本身是 Swift 6.4
// （Xcode 27 beta / swiftlang-6.4.0.30.4），6.1→6.4 给的是下面这些 upcoming feature
// 开关和新 API，不是新语言模式。下一个语言模式是 7，尚未开放。
//
// SWIFT_VERSION 与 SWIFT_STRICT_CONCURRENCY / SWIFT_APPROACHABLE_CONCURRENCY
// 仍在 pbxproj 的 target 级，本文件只承载「本轮新加」的开关。

// MARK: - Swift 7 语言模式的 upcoming feature
//
// 下面这些 feature 在语言模式 7 会默认打开（`swift-frontend -print-supported-features`
// 里 enabled_in = 7）。提前开等于把那笔债现在还掉，而不是等语言模式 7 落地时一次性爆。

// InternalImportsByDefault（SE-0409）：`import` 默认 internal 而非 public。
// 对 App target 是空转（实测 0 条诊断）——App 不对外暴露 API，没有 public import 可言。
// 开它的价值是语言模式 7 落地时不会突然冒出来。
SWIFT_UPCOMING_FEATURE_INTERNAL_IMPORTS_BY_DEFAULT = YES

// ImmutableWeakCaptures：捕获列表里的 weak 引用变成不可变。实测 0 条诊断。
//
// 这一个**没有对应的 Xcode build setting**（Xcode 27 的 Swift.xcspec 里查无此项），
// 只能走 OTHER_SWIFT_FLAGS。$(inherited) 必须写：后面再叠 flag 时不写就会覆盖掉前一个。
OTHER_SWIFT_FLAGS = $(inherited) -enable-upcoming-feature ImmutableWeakCaptures

// MemberImportVisibility（SE-0444）：用到某个模块的成员就必须自己 import 它，
// 不能靠别的文件/模块「顺带」带进来。
//
// 直接开是 139 个 error 看着吓人，实际只是 13 个文件各缺一行 import——其中 104 条
// 报在 <unknown>:0（@Published 的 _enclosingInstance 下标展开，没有文件位置），
// 另有 10 条 "does not conform to ObservableObject" 是缺 import Combine 的连带错误。
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES

// ExistentialAny（SE-0335）：协议当类型用必须写 any。67 处，纯机械。
// 其中 27 处是可选，要写 (any X)? 而不是 any X?——后者是硬错误，不会静默。
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES

// MARK: - 内存安全
//
// StrictMemorySafety（SE-0458）：用到不安全语言构造或 API 而没有明确承认时报警。
// 它不是 upcoming feature（语言模式 7 也不会默认开），是**可选**的严格档，
// 与 `-strict-concurrency=complete` 同性质：编译器帮你把「这里绕过了安全检查」标出来。
//
// 开它的代价是 502 条诊断，全部在 2026-09-17 这一轮按三档收掉了：
// 能改成安全代码的先改（`String(format:)` → `Models.swift` 的「数字成串」三件套、
// QRC 的手写 inflate → `NSData.decompressed`）；无安全替代但反复出现的收进
// `Amber/Safety/AppKitSafeAccess.swift` 的 `@safe` 外壳（AppKit 的 `unowned(unsafe)`
// 反向指针 84 处）；剩下本质不安全的就地 `unsafe` + 契约注释（AudioTap 的实时回调、
// SQLite 的 C 绑定、CoreAudio / CoreText / Metal 那几族）。
//
// 开着它的用处在往后：新写的代码一碰裸指针就会报，而不是等出事才发现。
// 反向哨兵是 `[#UnnecessaryUnsafe]`——标过头了编译器会指出来，**且这一条在开关关着时
// 也报**，所以平时的 warning 基线就能兜住「有没有乱套 fix-it」。
SWIFT_STRICT_MEMORY_SAFETY = YES
